              "distancia": 0.2,
              "promociones": 0.05,
              "tiempo": 0.15
            },
            "prioridad_aplicada": "CONVENIENCIA",
            "reglas_activadas": [
              "R06",
              "R07"
            ],
            "request_id": "demo-001",
            "trace": [
